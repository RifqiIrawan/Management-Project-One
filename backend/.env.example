APP_ENV=development
PORT=6990
# Alamat bind. Kosong = semua antarmuka (development). Production default 127.0.0.1
# (API hanya lewat reverse proxy). Isi 0.0.0.0 bila memang tanpa proxy.
#HOST=127.0.0.1

DB_HOST=localhost
DB_PORT=5432
DB_USER=mpo
DB_PASSWORD=ganti_dengan_password_kuat
DB_NAME=management_project_one
DB_SSLMODE=disable

CORS_ORIGINS=http://localhost:6969

# Wajib, minimal 32 karakter acak. Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
JWT_ISSUER=management-project-one
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Acuan hari/minggu untuk filter deadline (Terlambat, Hari ini, Minggu ini)
APP_TIMEZONE=Asia/Jakarta

COOKIE_SECURE=false
BCRYPT_COST=12

# --- Operasional ---
# Batas request per menit per user (API terautentikasi). 0 = nonaktif.
API_RATE_LIMIT_PER_MIN=100
# IP/CIDR reverse proxy yang dipercaya untuk membaca IP klien dari X-Forwarded-For
# (mis. 127.0.0.1 bila Nginx/Caddy satu server). Kosong = abaikan header tersebut.
TRUSTED_PROXIES=
# Swagger UI di /api/docs. Default: aktif di development, nonaktif di production.
SWAGGER_ENABLED=
# Pembersihan refresh token kedaluwarsa (0 = nonaktif).
TOKEN_CLEANUP_INTERVAL=1h
